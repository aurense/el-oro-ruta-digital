---
// BaseLayout.astro
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pasaporte El Oro – Pueblo Mágico Minero</title>
    <meta name="description" content="Pasaporte turístico digital de El Oro, Pueblo Mágico Minero del Estado de México. Escanea QR, escucha historias y colecciona sellos." />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#1E1008" />
    <!-- Tipografía premium: Cinzel para títulos, Inter para cuerpo -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <style>
      /* ─── Sistema de diseño: tokens globales ─────────────────────── */
      :root {
        /* Fondos */
        --bg-primary:   #12090A;
        --bg-card:      #1E1008;
        --bg-surface:   #2C1A0E;
        --bg-glass:     rgba(30, 16, 8, 0.80);

        /* Dorado – color protagonista */
        --gold-bright:  #F2C94C;
        --gold-mid:     #D4A017;
        --gold-dark:    #8B6914;
        --gold-glow:    rgba(242, 201, 76, 0.35);

        /* Ámbar / Cobre */
        --amber:        #E07B39;
        --amber-light:  #F5C87A;

        /* Texto */
        --text-primary: #F5E6C8;
        --text-muted:   #A08060;
        --text-dim:     #6B5040;

        /* Bordes */
        --border-gold:  rgba(212, 160, 23, 0.30);
        --border-dim:   rgba(212, 160, 23, 0.12);

        /* Estados */
        --success:      #4CAF82;
        --error:        #E05252;

        /* Radios */
        --radius-sm:    8px;
        --radius-md:    14px;
        --radius-lg:    22px;
        --radius-full:  9999px;

        /* Sombras */
        --shadow-gold:  0 0 20px rgba(212, 160, 23, 0.25);
        --shadow-card:  0 4px 24px rgba(0, 0, 0, 0.5);
      }

      /* ─── Reset y base ───────────────────────────────────────────── */
      *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        font-family: 'Inter', system-ui, sans-serif;
        background-color: var(--bg-primary);
        background-image:
          radial-gradient(ellipse 80% 50% at 50% -10%, #2C1A0E 0%, transparent 60%),
          radial-gradient(ellipse 40% 30% at 90% 90%, #1A0D05 0%, transparent 50%);
        background-attachment: fixed;
        color: var(--text-primary);
        min-height: 100vh;
        -webkit-font-smoothing: antialiased;
      }

      /* ─── Barra de navegación ────────────────────────────────────── */
      .nav-bar {
        position: sticky;
        top: 0;
        z-index: 100;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 14px 20px;
        background: var(--bg-glass);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border-bottom: 1px solid var(--border-gold);
      }

      .logo {
        font-family: 'Cinzel', serif;
        font-weight: 700;
        font-size: 1.05rem;
        letter-spacing: 0.5px;
        text-decoration: none;
        background: linear-gradient(135deg, var(--gold-bright), var(--gold-mid));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        transition: opacity 0.2s;
      }
      .logo:hover { opacity: 0.85; }

      .nav-link {
        color: var(--text-muted);
        text-decoration: none;
        font-size: 0.875rem;
        font-weight: 500;
        padding: 6px 12px;
        border-radius: var(--radius-full);
        border: 1px solid transparent;
        transition: all 0.2s;
      }
      .nav-link:hover {
        color: var(--gold-bright);
        border-color: var(--border-gold);
        background: rgba(212, 160, 23, 0.08);
      }

      /* ─── Main container ─────────────────────────────────────────── */
      main {
        max-width: 600px;
        margin: 0 auto;
        padding: 0 16px 40px;
      }

      /* ─── Utilidades globales ────────────────────────────────────── */
      .gold-text {
        background: linear-gradient(135deg, var(--gold-bright), var(--gold-mid));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      .card {
        background: var(--bg-card);
        border: 1px solid var(--border-dim);
        border-radius: var(--radius-md);
        padding: 20px;
      }

      .btn-gold {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        background: linear-gradient(135deg, var(--gold-mid), var(--gold-bright));
        color: var(--bg-primary);
        border: none;
        border-radius: var(--radius-full);
        padding: 12px 28px;
        font-family: 'Inter', sans-serif;
        font-weight: 600;
        font-size: 0.95rem;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.2s;
        box-shadow: 0 4px 16px rgba(212, 160, 23, 0.3);
      }
      .btn-gold:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 24px rgba(212, 160, 23, 0.5);
      }
      .btn-gold:active { transform: translateY(0); }

      .btn-outline {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        background: transparent;
        color: var(--gold-mid);
        border: 1px solid var(--border-gold);
        border-radius: var(--radius-full);
        padding: 11px 24px;
        font-family: 'Inter', sans-serif;
        font-weight: 500;
        font-size: 0.9rem;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.2s;
      }
      .btn-outline:hover {
        background: rgba(212, 160, 23, 0.1);
        border-color: var(--gold-bright);
        color: var(--gold-bright);
      }

      /* ─── Scrollbar personalizada ────────────────────────────────── */
      ::-webkit-scrollbar { width: 6px; }
      ::-webkit-scrollbar-track { background: var(--bg-primary); }
      ::-webkit-scrollbar-thumb {
        background: var(--gold-dark);
        border-radius: 3px;
      }
    </style>
  </head>
  <body>
    <nav class="nav-bar">
      <a href="/" class="logo">⛏️ Pasaporte El Oro</a>
      <a href="/perfil" class="nav-link">👤 Mi perfil</a>
    </nav>
    <slot />
    <script>
      import { habilitarPersistenciaOffline } from "../lib/firestore-persistence";
      import { iniciarSesionAnonima, escucharAuth } from "../lib/auth";
      import { userStore } from "../stores/user";
      import { obtenerUsuario } from "../lib/db";

      // Activar Firestore offline
      habilitarPersistenciaOffline();

      escucharAuth(async (uid) => {
        console.log("[Auth] uid:", uid);
        userStore.update((s) => ({ ...s, uid }));
        if (uid) {
          try {
            const datos = await obtenerUsuario(uid);
            console.log("[Auth] Datos Firestore:", datos);
            userStore.update((s) => ({
              ...s,
              perfil: datos?.perfil || null,
              sellos: datos?.sellos || [],
            }));
          } catch (e) {
            console.error("[Auth] Error al leer usuario:", e);
          }
        }
      });

      iniciarSesionAnonima();
    </script>
    <script src="/registerSW.js" is:inline></script>
  </body>
</html>
