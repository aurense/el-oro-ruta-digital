---
// DonationButton.astro - Componente nativo estático y accesible
const donationURL = import.meta.env.PUBLIC_DONATION_URL || "#";
---

<div class="donation-container">
  <a
    href={donationURL}
    target="_blank"
    rel="noopener noreferrer"
    class="donation-link"
    aria-label="Apoyar el proyecto Pasaporte El Oro con una donación voluntaria"
  >
    <span class="coffee-emoji" aria-hidden="true">☕</span>
    <span class="donation-text">¿Te gustó El Oro? Invítanos un café</span>
    <svg class="external-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
      <polyline points="15 3 21 3 21 9"></polyline>
      <line x1="10" y1="14" x2="21" y2="3"></line>
    </svg>
  </a>
</div>

<style>
  .donation-container {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    margin: 24px 0 12px;
  }

  .donation-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 9px 18px;
    background: rgba(44, 26, 14, 0.7);
    color: var(--text-primary, #F5E6C8);
    text-decoration: none;
    border-radius: var(--radius-full, 9999px);
    border: 1px solid var(--border-gold, rgba(212, 160, 23, 0.25));
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.85rem;
    font-weight: 500;
    transition: all 0.2s ease;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .donation-link:hover {
    background: rgba(60, 36, 20, 0.9);
    border-color: var(--gold-bright, #F2C94C);
    color: var(--gold-bright, #F2C94C);
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(212, 160, 23, 0.2);
  }

  .donation-link:active {
    transform: translateY(0);
  }

  .coffee-emoji {
    font-size: 1rem;
    transition: transform 0.2s ease;
  }

  .donation-link:hover .coffee-emoji {
    transform: scale(1.2) rotate(-8deg);
  }

  .external-icon {
    opacity: 0.6;
    margin-left: 2px;
  }

  .donation-link:hover .external-icon {
    opacity: 1;
  }
</style>
