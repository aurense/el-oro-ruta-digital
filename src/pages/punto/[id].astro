---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PuntoPage from "../../components/PuntoPage.svelte";
import { puntos } from "../../data/puntos";

export function getStaticPaths() {
    return puntos.map((p) => ({ params: { id: p.id } }));
}

const { id } = Astro.params;
const punto = puntos.find((p) => p.id === id);
const origen = Astro.url.searchParams.get("origen") || "desconocido";

if (!punto) {
    return Astro.redirect("/404");
}
---

<BaseLayout
    title={`${punto.nombre} – Pasaporte El Oro`}
    description={punto.descripcionCorta}
>
    <Fragment slot="head">
        <link rel="preload" as="image" href={punto.imagenMiniatura} />
        <link rel="preload" as="image" href={punto.insigniaURL} />
    </Fragment>
    <PuntoPage punto={punto} origen={origen} client:load />
</BaseLayout>
