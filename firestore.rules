rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Funciones Auxiliares de Seguridad ───────────────────────────
    
    // Verifica si el usuario autenticado tiene rol de Administrador
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.uid in [
          'XXMmhV4uRChh6qHW5c2HhqX9xQA3' // UID del administrador principal
        ]
      );
    }

    // Verifica si el usuario autenticado es el propietario del recurso
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // ─── 1. Puntos Turísticos Patrimoniales ──────────────────────────
    // Catálogo público de monumentos (Palacio, Teatro, Tiro Norte)
    match /puntos/{puntoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── 2. Aliados Comerciales y Artesanales ────────────────────────
    // Directorio de establecimientos locales, promociones y coordenadas
    match /aliados/{aliadoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── 3. Documentos de Usuario (Pasaportes Digitales) ──────────────
    // Almacena perfil del turista, monedas acumuladas, sellos y recompensas
    match /usuarios/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();

      // Subcolección de visitas detalladas y progreso de trivias por monumento
      match /visitas/{puntoId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update: if isOwner(uid) || isAdmin();
        allow delete: if isAdmin();
      }
    }

    // ─── 4. Registro de Visitas a Aliados Comerciales ────────────────
    // Registro de canje de vouchers, códigos QR y analíticas turísticas
    match /visitas_aliados/{visitaId} {
      // El turista solo puede registrar visitas con su propio UID
      allow create: if request.auth != null && 
        request.resource.data.uid == request.auth.uid;
      // Lectura permitida al propietario del registro o al administrador
      allow read: if (request.auth != null && resource.data.uid == request.auth.uid) || isAdmin();
      allow update, delete: if isAdmin();
    }

    // ─── Bloqueo por defecto para cualquier otra ruta no especificada ─
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
